{
  "_meta": {
    "description": "Reclaim's failure taxonomy, grounded in Razorpay's OFFICIAL documented error reason codes rather than an invented subset. Every rule in 'rules' maps a code listed on a Razorpay docs page into one of Reclaim's recovery categories (mapping categories is fine - the point is the table traces to the real API).",
    "sources": [
      "https://razorpay.com/docs/errors/payments/list/#bad-request-errors",
      "https://razorpay.com/docs/errors/payments/list/#gateway-errors",
      "https://razorpay.com/docs/errors/payments/cards/"
    ],
    "categories": [
      "insufficient_funds",
      "bank_server_downtime",
      "otp_timeout",
      "wrong_cvv_pin",
      "expired_card",
      "network_drop",
      "risk_fraud_block",
      "ambiguous"
    ],
    "mapping_policy": "Codes Razorpay documents as customer- or bank-actionable map to a concrete recovery strategy. Codes that are non-recoverable, business/request-level, or truly unknown map to 'ambiguous' (triage -> human review, never a blind auto-retry). Confidence reflects how unambiguous the doc description is."
  },
  "rules": [
