# Copy to .env and fill in.

# Optional LLM triage: only used for AMBIGUOUS failure codes.
# When unset, the engine runs fully deterministic on the heuristic fallback.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Comma-separated allow-list of merchant ids that may use LLM triage
# (leave empty to allow for all merchants).
LLM_MERCHANT_ALLOWLIST=

# LLM model (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ---- Razorpay TEST-MODE Payment Links ----
# The recovery execution step creates a real (test-mode) Payment Link for the
# "prompt for new card" / retry-link flows. Grab TEST keys from
# https://dashboard.razorpay.com/app/keys (Dashboard -> Settings -> API Keys).
# When these are blank, an offline mock link is used and the pipeline stays
# fully observable without touching Razorpay.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=