# Copy to .env and fill in.

# Optional LLM triage: only used for AMBIGUOUS failure codes.
# When unset, the engine runs fully deterministic on the heuristic fallback.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Comma-separated allow-list of merchant ids that may use LLM triage
# (leave empty to allow for all merchants).
LLM_MERCHANT_ALLOWLIST=

# LLM model (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash